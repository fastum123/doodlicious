# --- Supabase (gratis tier: https://supabase.com) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare Stream (pay-as-you-go: https://dash.cloudflare.com -> Stream) ---
# Goedkoopste optie voor beveiligd video-hosten: ~$5 / 1000 min opslag + $1 / 1000 min afspelen.
# Ondersteunt "signed URLs" zodat video's alleen via jouw site en met een tijdelijk token af te spelen zijn
# (domain-locking + verlopen tokens) i.p.v. dure Widevine/Fairplay DRM.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_KEY_PEM=

# --- Stripe (geen maandkosten, alleen transactiekosten, iDEAL beschikbaar voor NL) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
